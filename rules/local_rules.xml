<!-- Example -->
<group name="local,linux,auditd,docker,">

  <rule id="100140" level="0">
    <if_sid>80710</if_sid>
    <field name="audit.dev" type="pcre2">^veth[0-9A-Fa-f]+$</field>
    <match type="pcre2">comm="dockerd".*exe="/usr/bin/dockerd"</match>
    <description>Ignore benign Docker veth promiscuous-mode changes generated by dockerd.</description>
    <group>false_positive,docker,</group>
  </rule>

</group>

<group name="local,windows,scheduled_task,powershell,">

  <rule id="100150" level="10">
    <if_sid>60228</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)&lt;Command&gt;\s*(?:powershell|pwsh)(?:\.exe)?\s*&lt;/Command&gt;</field>
    <description>Windows: Scheduled task created to execute PowerShell.</description>
    <mitre>
      <id>T1053.005</id>
      <id>T1059.001</id>
    </mitre>
    <group>persistence,scheduled_task,powershell,</group>
  </rule>

</group>

<group name="local,windows,service,suspicious_path,">

  <rule id="100160" level="12">
    <if_sid>61138</if_sid>

    <field name="win.eventdata.imagePath" type="pcre2">(?i)^\s*"?[c-z]:\\\\(?:Users\\\\Public\\\\|Users\\\\[^\\\\]+\\\\AppData\\\\Local\\\\Temp\\\\|Windows\\\\Temp\\\\)</field>

    <description>Windows: New service created from a suspicious user-writable path.</description>

    <mitre>
      <id>T1543.003</id>
    </mitre>

    <group>persistence,privilege_escalation,windows_service,</group>
  </rule>

</group>
